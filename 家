-- 状態管理
local running = false

-- テレポート処理
local function teleportLoop()
	while running do
		if humanoidRootPart then
			humanoidRootPart.CFrame = CFrame.new(targetPosition)
		end
		task.wait(0.0001) -- 0.0001秒ごと
